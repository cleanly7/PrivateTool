{
  "name": "private-toolbox",
  "version": "0.1.0",
  "private": true,
  "description": "私人工具箱",
  "author": "private",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test lib/*.test.ts",
    "desktop": "npm run build && electron .",
    "build:app": "npm run build && node scripts/prepare-standalone.mjs && electron-builder --mac --dir",
    "build:installer": "npm run build:app && node scripts/create-macos-artifacts.mjs",
    "update:desktop": "npm run build:app && node scripts/copy-to-desktop.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.2"
  },
  "build": {
    "appId": "com.privatetoolbox.desktop",
    "productName": "私人工具箱",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".next",
        "to": ".",
        "filter": [
          "standalone/**/*"
        ]
      }
    ],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        "dir"
      ]
    }
  }
}
